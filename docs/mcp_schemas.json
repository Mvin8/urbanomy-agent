{
  "cancel_job": {
    "description": "Stop the job's worker process. Canceling one job does not stop another.",
    "inputSchema": {
      "properties": {
        "job_id": {
          "title": "Job Id",
          "type": "string"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "cancel_jobArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "cancel_jobDictOutput",
      "type": "object"
    }
  },
  "estimate_land_value": {
