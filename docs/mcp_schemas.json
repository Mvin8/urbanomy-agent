  "get_optimization_options": {
    "description": "Get target geometry, indicators, supported constraint names, units and physical limits. Select scenario_id from list_scenarios.",
    "inputSchema": {
      "properties": {
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Target Id"
        }
      },
      "required": [
        "scenario_id",
        "target_id"
      ],
