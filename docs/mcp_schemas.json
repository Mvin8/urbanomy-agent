      "properties": {
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Target Id"
        }
      },
      "required": [
        "scenario_id",
        "target_id"
      ],
      "title": "estimate_land_valueArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "estimate_land_valueDictOutput",
      "type": "object"
    }
  },
