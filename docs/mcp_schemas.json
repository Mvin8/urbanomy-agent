  "start_district_optimization": {
    "description": "Start NSGA-II with hard bounds and an LLM strategy score. Without a profile, omitted variables stay at baseline.\n        Profile \"test\": footprint 1 m² to 10% of site area, floors 1–10, MXI 0.1–1, all shares 0–1.\n        Explicit constraints replace profile bounds per parameter. Supply constraints or a profile.\n        Select scenario_id from list_scenarios. project_id is metadata only.\n        Get options first. strategy contains preferences; constraints contain hard numeric requirements.\n        use_llm=false runs two economic objectives only. Returns job_id; use status/result/cancel tools.\n        ",
    "inputSchema": {
      "$defs": {
        "Bounds": {
          "additionalProperties": false,
          "properties": {
            "max": {
              "title": "Max",
              "type": "number"
            },
            "min": {
              "title": "Min",
              "type": "number"
            },
            "type": {
              "const": "float",
              "default": "float",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "min",
            "max"
          ],
          "title": "Bounds",
          "type": "object"
        }
      },
      "properties": {
        "constraints": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/Bounds"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constraints"
        },
        "constraints_profile": {
          "anyOf": [
            {
              "const": "test",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constraints Profile"
        },
        "n_gen": {
          "default": 20,
          "title": "N Gen",
          "type": "integer"
        },
        "pop_size": {
          "default": 20,
          "title": "Pop Size",
          "type": "integer"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "seed": {
          "default": 42,
          "title": "Seed",
          "type": "integer"
        },
        "strategy": {
          "title": "Strategy",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Target Id"
        },
        "use_llm": {
          "default": true,
          "title": "Use Llm",
          "type": "boolean"
        }
      },
      "required": [
        "scenario_id",
        "target_id",
        "strategy"
      ],
      "title": "start_district_optimizationArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "start_district_optimizationDictOutput",
      "type": "object"
    }
  }
}
