# Copy to .env only if it does not already exist. Keep real secrets out of Git.
URBANOMY_HOST=127.0.0.1
URBANOMY_PORT=8080
URBANOMY_PUBLIC_URL=http://localhost:8080
DATA_DIR=data
URBANOMY_OUTPUT_DIR=outputs/server
URBANOMY_MAX_JOBS=2
URBANOMY_JOB_TIMEOUT=3600
# Required when exposing the HTTP service outside a trusted local environment.
URBANOMY_API_TOKEN=

# Needed only for use_llm=true. Existing API_KEY / CHAT_URL are also supported.
OPENAI_API_KEY=
OPENAI_BASE_URL=
URBANOMY_LLM_MODEL=
